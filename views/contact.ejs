<%- include("partials/header.ejs") %>
<h1>Contact Me</h1>
<img class="profile" src="images/contactMe.jpg" alt="AI GitHub logo profile">
<div class="contact-card">
  <p class="contact-card-copy">Have a question or want to collaborate? Send a message and I’ll reply shortly.</p>
  <% if (typeof success !== 'undefined') { %>
    <div class="form-response success"><%= success %></div>
  <% } %>
  <% if (typeof error !== 'undefined') { %>
    <div class="form-response error"><%= error %></div>
  <% } %>
  <form class="contact-form" method="POST" action="/contact">
    <input name="name" type="text" class="feedback-input" placeholder="Name" />
    <input name="email" type="email" class="feedback-input" placeholder="Email" />
    <textarea name="text" class="feedback-input" placeholder="Message"></textarea>
    <input type="submit" value="Send Message" />
  </form>
</div>

<%- include("partials/footer.ejs") %>